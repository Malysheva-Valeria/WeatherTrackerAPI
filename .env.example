# Database Configuration
DATABASE_URL=postgresql://weather_user:your_password@localhost:5432/weathertracker

# Environment: development | production
# У production застосунок НЕ запуститься з плейсхолдер-секретом, DEBUG=True або CORS '*'
ENVIRONMENT=development

# JWT Configuration
# Згенеруйте безпечне значення: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=http://api.openweathermap.org/data/2.5

# Application Configuration
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS: дозволені origin'и фронтенду (кома-розділений список)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache Configuration (for future use)
CACHE_TTL=600
REDIS_URL=redis://localhost:6379/0