"""Unit тести для AuthService"""
import pytest
from unittest.mock import Mock, patch, MagicMock
from datetime import datetime, timedelta
from jose import jwt
from passlib.context import CryptContext

from app.api.services.auth_service import AuthService
from app.api.models.user import User
from app.core.config import get_settings


class TestAuthService:
    """Unit тести для AuthService"""

    @pytest.fixture
    def auth_service(self):
        """Фікстура AuthService"""
        return AuthService()

    @pytest.fixture
    def mock_db(self):
        """Мок бази даних"""
        return Mock()

    @pytest.fixture
    def mock_user(self):
        """Мок користувача"""
        user = Mock(spec=User)
        user.id = 1
        user.username = "testuser"
        user.email = "test@example.com"
        user.hashed_password = "$2b$12$hashedpassword"
        user.is_active = True
        return user

    def test_hash_password(self, auth_service):
        """Тест хешування пароля"""
        password = "testpass123"
        hashed = auth_service.hash_password(password)

        assert hashed != password
        assert auth_service.verify_password(password, hashed) is True
        assert auth_service.verify_password("wrongpass", hashed) is False

    def test_verify_password(self, auth_service):
        """Тест перевірки пароля"""
        password = "testpass123"
        hashed = auth_service.hash_password(password)

        # Правильний пароль
        assert auth_service.verify_password(password, hashed) is True

        # Неправильний пароль
        assert auth_service.verify_password("wrongpass", hashed) is False

    def test_create_access_token(self, auth_service):
        """Тест створення JWT токена"""
        data = {"sub": "1", "username": "testuser"}
        token = auth_service.create_access_token(data)

        assert isinstance(token, str)
        assert len(token.split('.')) == 3  # JWT має 3 частини

        # Декодування токена
        settings = get_settings()
        decoded = jwt.decode(token, settings.SECRET_KEY, algorithms=[settings.ALGORITHM])

        assert decoded["sub"] == "1"
        assert decoded["username"] == "testuser"
        assert "exp" in decoded

    def test_create_access_token_with_expiry(self, auth_service):
        """Тест створення токена з custom термін дії"""
        data = {"sub": "1"}
        expires_delta = timedelta(minutes=30)
        token = auth_service.create_access_token(data, expires_delta)

        settings = get_settings()
        decoded = jwt.decode(token, settings.SECRET_KEY, algorithms=[settings.ALGORITHM])

        # Перевірка терміну дії
        exp_time = datetime.fromtimestamp(decoded["exp"])
        expected_time = datetime.utcnow() + expires_delta

        # Допустима похибка 5 секунд
        assert abs((exp_time - expected_time).total_seconds()) < 5

    def test_verify_token_valid(self, auth_service):
        """Тест перевірки валідного токена"""
        data = {"sub": "1", "username": "testuser"}
        token = auth_service.create_access_token(data)

        payload = auth_service.verify_token(token)

        assert payload["sub"] == "1"
        assert payload["username"] == "testuser"

    def test_verify_token_invalid(self, auth_service):
        """Тест перевірки невалідного токена"""
        invalid_token = "invalid.jwt.token"

        payload = auth_service.verify_token(invalid_token)
        assert payload is None

    def test_verify_token_expired(self, auth_service):
        """Тест перевірки застарілого токена"""
        # Створення токена з терміном дії в минулому
        data = {"sub": "1"}
        past_time = timedelta(minutes=-1)  # 1 хвилина назад

        with patch('app.api.services.auth_service.datetime') as mock_datetime:
            mock_datetime.utcnow.return_value = datetime.utcnow() + past_time
            token = auth_service.create_access_token(data, timedelta(minutes=1))

        # Токен має бути застарілим
        payload = auth_service.verify_token(token)
        assert payload is None

    def test_authenticate_user_success(self, auth_service, mock_db, mock_user):
        """Тест успішної аутентифікації користувача"""
        # Налаштування мока бази даних
        mock_db.query.return_value.filter.return_value.first.return_value = mock_user

        # Налаштування пароля
        password = "testpass123"
        mock_user.hashed_password = auth_service.hash_password(password)

        # Тест аутентифікації
        result = auth_service.authenticate_user(mock_db, "testuser", password)

        assert result == mock_user
        mock_db.query.assert_called_once()

    def test_authenticate_user_not_found(self, auth_service, mock_db):
        """Тест аутентифікації неіснуючого користувача"""
        # Користувач не знайдений
        mock_db.query.return_value.filter.return_value.first.return_value = None

        result = auth_service.authenticate_user(mock_db, "nonexistent", "password")

        assert result is None

    def test_authenticate_user_wrong_password(self, auth_service, mock_db, mock_user):
        """Тест аутентифікації з неправильним паролем"""
        # Налаштування мока
        mock_db.query.return_value.filter.return_value.first.return_value = mock_user
        mock_user.hashed_password = auth_service.hash_password("correct_password")

        result = auth_service.authenticate_user(mock_db, "testuser", "wrong_password")

        assert result is None

    def test_get_user_by_token_success(self, auth_service, mock_db, mock_user):
        """Тест отримання користувача за валідним токеном"""
        # Створення валідного токена
        token = auth_service.create_access_token({"sub": str(mock_user.id)})

        # Налаштування мока бази даних
        mock_db.query.return_value.filter.return_value.first.return_value = mock_user

        result = auth_service.get_user_by_token(mock_db, token)

        assert result == mock_user
        mock_db.query.assert_called_once()

    def test_get_user_by_token_invalid(self, auth_service, mock_db):
        """Тест отримання користувача за невалідним токеном"""
        invalid_token = "invalid.token"

        result = auth_service.get_user_by_token(mock_db, invalid_token)

        assert result is None

    def test_get_user_by_token_user_not_found(self, auth_service, mock_db):
        """Тест отримання користувача коли користувач не знайдений в БД"""
        # Створення валідного токена для неіснуючого користувача
        token = auth_service.create_access_token({"sub": "999"})

        # Користувач не знайдений в БД
        mock_db.query.return_value.filter.return_value.first.return_value = None

        result = auth_service.get_user_by_token(mock_db, token)

        assert result is None


